# Copy to .env and fill in. .env is gitignored -- never commit real keys.

# Local Ollama chat model
OLLAMA_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://localhost:11434

# Local embedding model. Must match the model used at ingest time,
# or retrieval silently returns garbage.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Optional. Enables Tavily web research, which informs PLANNING ONLY and can
# never appear in an answer (see research.py). Leave unset to run fully local.
# TAVILY_API_KEY=tvly-...

# Optional overrides
# ENABLE_WEB_RESEARCH=true
# OLLAMA_NUM_CTX=8192
# MAX_ITERATIONS=2
# MAX_PLAN_STEPS=4
# MAX_EVIDENCE_CHARS=12000
